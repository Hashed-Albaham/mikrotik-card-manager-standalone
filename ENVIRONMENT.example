# Copy these keys into your deployment provider's protected environment-variable UI.
# For Docker Compose, create an untracked file named .env containing the same keys.
# Replace all placeholders locally; do not commit real values.
MYSQL_DATABASE=mikrotik_cards
MYSQL_USER=mikrotik_app
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RESOURCE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
INITIAL_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
INITIAL_ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH_GENERATED_OUTSIDE_GIT
# INITIAL_ADMIN_PASSWORD is accepted for a one-time development migration only; prefer the hash above.
INITIAL_DEMO_USERNAME=OPTIONAL_DEMO_USERNAME
INITIAL_DEMO_PASSWORD_HASH=OPTIONAL_BCRYPT_HASH_FOR_A_DEMO_USER
APP_PORT=3000
